DISCORD_TOKEN=your_discord_bot_token_here

# Admin dashboard (optional)
# If DASHBOARD_PASSWORD is empty, dashboard stays disabled.
# DASHBOARD_PASSWORD=change_me
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080

# raid-report-hub integration (optional)
# HUB_API_BASE_URL=http://localhost:5173
# HUB_API_SECRET=shared_secret_with_raid_report_hub
# HUB_SYNC_INTERVAL_SECONDS=15

# Participation tracking is configured per server with /participation setup_* commands.
# The bot needs Guilds, Voice States, and Messages intents enabled. Message Content is not required.

